Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", "kx", " ", "x"}], " ", "+", " ", 
      RowBox[{"\[ImaginaryI]", " ", "ky", " ", "y"}]}], "]"}], " ", 
    RowBox[{"Exp", "[", 
     FractionBox[
      RowBox[{"-", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["kx", "2"], "+", " ", 
         SuperscriptBox["ky", "2"], " ", "+", " ", 
         SuperscriptBox["m", "2"]}], ")"}]}], 
      RowBox[{"8", " ", 
       SuperscriptBox["\[Beta]", "2"], "z", 
       RowBox[{"(", 
        RowBox[{"1", "-", "z"}], ")"}]}]], "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"kx", ",", 
     RowBox[{"-", " ", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
   
   RowBox[{"{", 
    RowBox[{"ky", ",", 
     RowBox[{"-", " ", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
   
   RowBox[{"Assumptions", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m", ">", "0"}], ",", " ", 
      RowBox[{"z", ">", "0"}], ",", " ", 
      RowBox[{"\[Beta]", ">", "0"}]}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.970662668131215*^9, 3.9706626728330507`*^9}, {
  3.9706627131604*^9, 3.970662738731419*^9}, {3.9706628719740953`*^9, 
