Cell[BoxData[
 TemplateBox[{
   RowBox[{
     RowBox[{"-", "8"}], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
        FractionBox[
         SuperscriptBox["m", "2"], 
         RowBox[{"8", " ", 
           RowBox[{"(", 
             RowBox[{
               RowBox[{"-", "1"}], "+", "z"}], ")"}], " ", "z", " ", 
           SuperscriptBox["\[Beta]", "2"]}]], "+", 
        RowBox[{"2", " ", 
          RowBox[{"(", 
            RowBox[{
              SuperscriptBox["x", "2"], "+", 
              SuperscriptBox["y", "2"]}], ")"}], " ", 
          RowBox[{"(", 
            RowBox[{
              RowBox[{"-", "1"}], "+", "z"}], ")"}], " ", "z", " ", 
          SuperscriptBox["\[Beta]", "2"]}]}]], " ", "\[Pi]", " ", 
     RowBox[{"(", 
       RowBox[{
         RowBox[{"-", "1"}], "+", "z"}], ")"}], " ", "z", " ", 
     SuperscriptBox["\[Beta]", "2"]}], 
   RowBox[{"z", "<", "1"}]},
  "ConditionalExpression"]], "Output",
